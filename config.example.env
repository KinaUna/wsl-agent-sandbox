# Copy this file to config.env and edit it. config.env is git-ignored.
#
# Rules: one KEY=VALUE per line, comments only on their own lines.
# Allowed characters in values: letters digits _ . : / @ + , -   (no spaces, no quotes)

# Name of the dedicated WSL distro (also the SSH "Host" alias used by VS Code)
DISTRO=sandbox-agent

# Distro image to install (see: wsl --list --online)
UBUNTU_DISTRO=Ubuntu-24.04

# Maintenance user with sudo. Do NOT use "admin" (Ubuntu already has a group of that name).
ADMIN_USER=wsladmin

# Unprivileged user the agent runs as: no sudo, no docker group
AGENT_USER=agent

# sshd listens on 127.0.0.1:<SSH_PORT> inside the distro (loopback only)
SSH_PORT=2222

# Name of the key pair created on Windows (in %USERPROFILE%\.ssh) for VS Code Remote - SSH
WIN_SSH_KEY_NAME=id_ed25519_sandbox_agent

# Optional toolchains installed system-wide by scripts/wsl/20-packages.sh (1 = install)
INSTALL_DOTNET=0
DOTNET_CHANNEL=10.0
# Also install the dotnet-ef global tool for the agent user (needs INSTALL_DOTNET=1)
INSTALL_DOTNET_EF=0
INSTALL_NODE=0

# Optional: project cloned by scripts/wsl/45-clone-project.sh (use the SSH URL)
PROJECT_REPO=
# Folder under the agent's home that holds cloned projects
PROJECT_DIR=projects
